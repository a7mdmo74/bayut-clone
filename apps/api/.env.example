# =============================================
# Bayara API — environment template (development)
# Copy to `.env` and fill in real values. Do not commit secrets.
# =============================================

# --- Core (required) ---
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://bayut_user:bayut_password@localhost:5432/bayut_db

# --- Auth / JWT (required) ---
# Secrets must be at least 32 characters
JWT_SECRET=your-super-secret-jwt-key-at-least-32-characters-long
JWT_REFRESH_SECRET=your-super-secret-refresh-key-at-least-32-characters-long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# --- AWS S3 uploads (required) ---
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=eu-north-1
AWS_S3_BUCKET=bayut-clone-images

# --- App URLs (required for Stripe Checkout return / cancel; defaults shown) ---
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:3001

# --- Email provider (Resend) ---
# Optional: if not set, email features will be disabled
RESEND_API_KEY=
EMAIL_FROM=Bayara <noreply@ahmedamer.dev>

# --- Logging (optional) ---
LOG_LEVEL=info

# --- Stripe payments (test mode for local development) ---
# Use sk_test_… / whsec_… from https://dashboard.stripe.com/test/apikeys
# Leave both empty to use the local mock checkout (non-production only).
# For real webhook delivery locally, run:
#   stripe listen --forward-to localhost:3001/payments/webhooks/stripe
# and paste the printed whsec_… into STRIPE_WEBHOOK_SECRET (CLI secret ≠ Dashboard secret).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Manual Stripe Dashboard step (not an env var):
# Register webhook URL → ${API_URL}/payments/webhooks/stripe
# Events: checkout.session.completed, checkout.session.expired

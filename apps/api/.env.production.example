# =============================================
# Bayara API — production environment template
# Copy to `.env.production` (DO NOT COMMIT real values).
# Startup refuses to boot when NODE_ENV=production and STRIPE_SECRET_KEY is sk_test_*.
# =============================================

# --- Core (required) ---
NODE_ENV=production
PORT=5000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# --- Auth / JWT (required) ---
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-another-long-random-secret-32+
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# --- AWS S3 uploads (required) ---
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=eu-north-1
AWS_S3_BUCKET=bayut-clone-images

# --- App URLs (required — real production domains) ---
FRONTEND_URL=https://yourdomain.com
API_URL=https://api.yourdomain.com

# --- CORS (required for production security) ---
CORS_ORIGIN=https://yourdomain.com

# --- Email provider (Resend) ---
# Optional: if not set, email features will be disabled
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=Bayara <noreply@ahmedamer.dev>

# --- Logging (optional) ---
LOG_LEVEL=info

# --- Stripe payments (required in production — live keys only) ---
STRIPE_SECRET_KEY=sk_live_your_live_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_dashboard_webhook_signing_secret

# Manual Stripe Dashboard step (not an env var):
# Register live webhook endpoint:
#   https://api.yourdomain.com/payments/webhooks/stripe
# Events: checkout.session.completed, checkout.session.expired

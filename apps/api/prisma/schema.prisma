// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMS
// ==========================================

enum UserRole {
  BUYER
  AGENT
  AGENCY_ADMIN
  ADMIN
}

enum PropertyType {
  APARTMENT
  VILLA
  TOWNHOUSE
  PENTHOUSE
  STUDIO
  OFFICE
  RETAIL
  WAREHOUSE
  LAND
  BUILDING
}

enum ListingType {
  SALE
  RENT
}

enum ListingStatus {
  DRAFT
  ACTIVE
  RESERVED // Buyer paid reservation fee; sale not yet legally finalized
  PENDING
  RENTED
  SOLD
  EXPIRED
  REJECTED
}

enum RentFrequency {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CLOSED
  SPAM
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PlanInterval {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum PaymentProvider {
  STRIPE
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  CANCELED
}

enum PaymentPurpose {
  SUBSCRIPTION
  LISTING_BOOST
  LEAD_CREDITS
  VIEWING_DEPOSIT
  PROPERTY_RESERVATION
}

enum ViewingStatus {
  REQUESTED
  DEPOSIT_PENDING
  CONFIRMED
  COMPLETED
  CANCELED_BY_BUYER
  CANCELED_BY_AGENT
  NO_SHOW
}

enum DepositStatus {
  PENDING
  HELD
  REFUNDED
  FORFEITED
  FAILED
}

// ==========================================
// AUTH / USERS
// ==========================================

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  phone         String?  @unique
  password      String
  firstName     String
  lastName      String
  avatarUrl     String?
  role          UserRole @default(BUYER)
  isVerified    Boolean  @default(false)
  isActive      Boolean  @default(true)
  resetToken    String?  @unique
  resetTokenExpiresAt DateTime?
  verificationToken    String?  @unique
  verificationTokenExpiresAt DateTime?
  agentApplication AgentApplication?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  agent         Agent?
  properties    Property[]      @relation("PropertyOwner")
  favorites     Favorite[]
  savedSearches SavedSearch[]
  leadsSent     Lead[]          @relation("LeadSender")
  refreshTokens RefreshToken[]
  viewings      Viewing[]
  notifications Notification[]
  reviews       AgentReview[]
  auditLogs     AuditLog[]
  searchLogs    SearchLog[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  revoked   Boolean  @default(false)

  @@map("refresh_tokens")
}

// ==========================================
// AGENCY / AGENT
// ==========================================

model Agency {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  logoUrl     String?
  description String?
  phone       String?
  email       String?
  website     String?
  licenseNo   String?  @unique
  isVerified  Boolean  @default(false)
  agentApplications AgentApplication[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  agents      Agent[]
  properties  Property[]

  @@map("agencies")
}

model Agent {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  agencyId     String?
  agency       Agency?  @relation(fields: [agencyId], references: [id])
  licenseNo    String?  @unique
  bio          String?
  languages    String[] // e.g. ["en", "ar"]
  leadCredits  Int      @default(0) // purchased lead credits for contact reveals
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  properties      Property[] @relation("PropertyAgent")
  subscriptions   Subscription[]
  viewings        Viewing[]
  reviews         AgentReview[]
  availability    AgentAvailability[]

  @@map("agents")
}

model AgentApplication {
  id         String            @id @default(uuid())
  userId     String            @unique
  user       User              @relation(fields: [userId], references: [id])
  licenseNo  String?
  bio        String?
  languages  String[]
  agencyId   String?
  agency     Agency?           @relation(fields: [agencyId], references: [id])
  status     ApplicationStatus @default(PENDING)
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime          @default(now())

  @@map("agent_applications")
}

// ==========================================
// LOCATION HIERARCHY (UAE style)
// ==========================================

model Emirate {
  id         String      @id @default(uuid())
  name       String      @unique // Dubai, Abu Dhabi, Sharjah, Ajman...
  slug       String      @unique
  communities Community[]

  @@map("emirates")
}

model Community {
  id            String        @id @default(uuid())
  name          String        // Dubai Marina, Downtown Dubai, JVC...
  slug          String
  emirateId     String
  emirate       Emirate       @relation(fields: [emirateId], references: [id])
  subCommunities SubCommunity[]
  properties    Property[]

  @@unique([emirateId, slug])
  @@map("communities")
}

model SubCommunity {
  id          String     @id @default(uuid())
  name        String     // e.g. "Marina Gate", "JVC District 12"
  slug        String
  communityId String
  community   Community  @relation(fields: [communityId], references: [id])
  properties  Property[]

  @@unique([communityId, slug])
  @@map("sub_communities")
}

// ==========================================
// PROPERTY (acts as the listing itself)
// ==========================================

model Property {
  id              String        @id @default(uuid())
  title           String
  slug            String        @unique
  description     String
  propertyType    PropertyType
  listingType     ListingType
  status          ListingStatus @default(DRAFT)

  price           Decimal       @db.Decimal(12, 2)
  rentFrequency   RentFrequency? // only relevant when listingType = RENT

  bedrooms        Int?
  bathrooms       Int?
  areaSqft        Decimal?      @db.Decimal(10, 2)
  floor           Int?
  parkingSpots    Int?
  furnished       Boolean       @default(false)

  emirateId       String?
  communityId     String?
  community       Community?    @relation(fields: [communityId], references: [id])
  subCommunityId  String?
  subCommunity    SubCommunity? @relation(fields: [subCommunityId], references: [id])
  addressLine     String?
  latitude        Decimal?      @db.Decimal(9, 6)
  longitude       Decimal?      @db.Decimal(9, 6)

  ownerId         String
  owner           User          @relation("PropertyOwner", fields: [ownerId], references: [id])
  agentId         String?
  agent           Agent?        @relation("PropertyAgent", fields: [agentId], references: [id])
  agencyId        String?
  agency          Agency?       @relation(fields: [agencyId], references: [id])

  viewsCount      Int           @default(0)
  isFeatured      Boolean       @default(false)
  featuredExpiry  DateTime?     // when featured status expires
  publishedAt     DateTime?
  expiresAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  images          PropertyImage[]
  amenities       PropertyAmenity[]
  favorites       Favorite[]
  leads           Lead[]
  viewings        Viewing[]

  @@index([listingType, propertyType, status])
  @@index([communityId])
  @@index([price])
  @@map("properties")
}

model PropertyImage {
  id         String   @id @default(uuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  url        String
  isCover    Boolean  @default(false)
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  @@map("property_images")
}

model Amenity {
  id         String            @id @default(uuid())
  name       String            @unique // Pool, Gym, Balcony, Maid's Room...
  icon       String?
  properties PropertyAmenity[]

  @@map("amenities")
}

model PropertyAmenity {
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amenityId  String
  amenity    Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([propertyId, amenityId])
  @@map("property_amenities")
}

// ==========================================
// LEADS / FAVORITES / SAVED SEARCHES
// ==========================================

model Lead {
  id         String     @id @default(uuid())
  propertyId String
  property   Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  senderId   String?
  sender     User?      @relation("LeadSender", fields: [senderId], references: [id])
  name       String
  email      String
  phone      String
  message    String?
  status     LeadStatus @default(NEW)
  createdAt  DateTime   @default(now())

  @@index([propertyId, status])
  @@map("leads")
}

model Favorite {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, propertyId])
  @@map("favorites")
}

model SavedSearch {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  filters   Json     // { propertyType, listingType, minPrice, maxPrice, bedrooms, communityId... }
  alertsOn  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("saved_searches")
}

// ==========================================
// PAYMENTS / SUBSCRIPTIONS
// ==========================================

model Plan {
  id             String       @id @default(uuid())
  name           String
  interval       PlanInterval
  priceAed       Decimal      @db.Decimal(10, 2)
  maxListings    Int
  maxFeatured    Int
  isActive       Boolean      @default(true)
  subscriptions  Subscription[]

  @@map("plans")
}

model Subscription {
  id                 String             @id @default(uuid())
  agentId            String
  agent              Agent              @relation(fields: [agentId], references: [id])
  planId             String
  plan               Plan               @relation(fields: [planId], references: [id])
  status             SubscriptionStatus @default(ACTIVE)
  providerRef        String?            // Stripe customer/subscription reference
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  payments           Payment[]

  @@index([agentId])
  @@index([status])
  @@map("subscriptions")
}

model Payment {
  id             String          @id @default(uuid())
  subscriptionId String?
  subscription   Subscription?   @relation(fields: [subscriptionId], references: [id])
  userId         String
  provider       PaymentProvider
  purpose        PaymentPurpose
  amountAed      Decimal         @db.Decimal(10, 2)
  status         PaymentStatus   @default(PENDING)
  providerRef    String          @unique // provider's transaction/order ID
  idempotencyKey String          @unique // prevents double-charging from webhook retries
  metadata       Json?           // e.g. { propertyId } for boosts, { creditCount } for lead credits, { viewingId } for viewing deposits
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([status])
  @@index([userId])
  @@map("payments")
}

// ==========================================
// VIEWINGS / DEPOSITS
// ==========================================

model Viewing {
  id             String        @id @default(uuid())
  propertyId     String
  property       Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  buyerId        String
  buyer          User          @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  agentId        String?
  agent          Agent?        @relation(fields: [agentId], references: [id])
  scheduledAt    DateTime
  status         ViewingStatus @default(REQUESTED)
  depositStatus  DepositStatus @default(PENDING)
  depositAmount  Decimal       @db.Decimal(10, 2)
  depositPaymentId String?      @unique // Links to Payment.id (one-way relation for simplicity)
  cancelReason   String?
  canceledAt     DateTime?
  completedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([buyerId])
  @@index([propertyId])
  @@index([status])
  @@index([scheduledAt])
  @@map("viewings")
}

// ==========================================
// NOTIFICATIONS
// ==========================================

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String   // LEAD, VIEWING, PAYMENT, SYSTEM
  title     String
  message   String
  link      String?  // URL to navigate to
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, read])
  @@index([createdAt])
  @@map("notifications")
}

// ==========================================
// AGENT REVIEWS
// ==========================================

model AgentReview {
  id        String   @id @default(uuid())
  agentId   String
  userId    String
  rating    Int      // 1-5 stars
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([agentId, userId])
  @@index([agentId])
  @@index([userId])
  @@map("agent_reviews")
}

// ==========================================
// AGENT AVAILABILITY
// ==========================================

model AgentAvailability {
  id        String   @id @default(uuid())
  agentId   String
  dayOfWeek Int      // 0=Sunday, 6=Saturday
  startTime String   // "09:00"
  endTime   String   // "17:00"
  isActive  Boolean  @default(true)

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, dayOfWeek])
  @@index([agentId])
  @@map("agent_availability")
}

// ==========================================
// AUDIT LOG
// ==========================================

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String   // USER_UPDATE, PROPERTY_REVIEW, AGENCY_VERIFY, etc.
  targetType String  // User, Property, Agency, Agent, etc.
  targetId  String
  details   Json?    // { before: ..., after: ... }
  ipAddress String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ==========================================
// SEARCH ANALYTICS
// ==========================================

model SearchLog {
  id        String   @id @default(uuid())
  userId    String?
  query     String?
  filters   Json?
  resultCount Int
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@map("search_logs")
}

{
  "name": "bayut-clone",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "postinstall": "node -e \"const fs=require('fs'),p=require('path');const web='apps/web/node_modules',root='node_modules';['next','react','react-dom','framer-motion','next-intl','next-themes'].forEach(pkg=>{const t=p.join(root,pkg),s=p.join(web,pkg);if(fs.existsSync(s)&&!fs.existsSync(t))fs.symlinkSync(s,t)})\""
  },
  "devDependencies": {
    "prettier": "^3.9.5",
    "turbo": "^2.10.5",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1086.0",
    "@aws-sdk/s3-request-presigner": "^3.1086.0"
  }
}
